          "widget": {
            "name": "definitions",
            "multilineTextboxSpec": {
              "lines": [
                "Revenue = captures minus refunds; lost revenue = terminal failed orders (not causal incremental loss). Unknown outcomes are excluded from revenue/loss. Filter dates to Oct 10 for the incident; 5 affected enterprise customers downgraded afterward."
              ]
            }
          },
          "position": {
            "x": 0,
