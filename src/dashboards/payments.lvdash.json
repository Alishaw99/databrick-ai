{
  "datasets": [
    {
      "name": "payments",
      "displayName": "Payments",
      "queryLines": [
        "SELECT `Date` AS `date`, `Hour` AS `hour`, `Region` AS `region`, `Channel` AS `channel`, `Gateway` AS `gateway`, `Tier` AS `tier`, `Customer ID` AS `customer_id`, `Customer Name` AS `customer_name`, `Affected Customer ID` AS `affected_customer_id`, `Downgraded` AS `downgraded`, MEASURE(`Revenue`) AS metric_revenue, MEASURE(`Lost Revenue`) AS metric_lost_revenue, MEASURE(`Orders`) AS metric_orders, MEASURE(`Failed Orders`) AS metric_failed_orders, MEASURE(`Payment Attempts`) AS metric_attempts, MEASURE(`Failed Attempts`) AS metric_failed_attempts\nFROM payments_metrics\nGROUP BY ALL ORDER BY hour, gateway"
      ],
      "columns": [
        {
          "displayName": "Revenue",
          "expression": "SUM(`metric_revenue`)"
        },
        {
          "displayName": "Lost Revenue",
          "expression": "SUM(`metric_lost_revenue`)"
        },
        {
          "displayName": "Orders",
          "expression": "SUM(`metric_orders`)"
        },
        {
          "displayName": "Failed Orders",
          "expression": "SUM(`metric_failed_orders`)"
        },
        {
          "displayName": "Payment Attempts",
          "expression": "SUM(`metric_attempts`)"
        },
        {
          "displayName": "Failed Attempts",
          "expression": "SUM(`metric_failed_attempts`)"
        },
        {
          "displayName": "Payment Failure Rate",
          "expression": "SUM(`metric_failed_attempts`) / NULLIF(SUM(`metric_attempts`),0)"
        },
        {
          "displayName": "Affected Enterprise Customers",
          "expression": "COUNT(DISTINCT `affected_customer_id`)"
        }
      ]
    },
    {
      "name": "enterprise",
      "displayName": "Enterprise",
      "queryLines": [
        "SELECT `Date` AS `date`, `Hour` AS `hour`, `Region` AS `region`, `Channel` AS `channel`, `Gateway` AS `gateway`, `Tier` AS `tier`, `Customer ID` AS `customer_id`, `Customer Name` AS `customer_name`, `Affected Customer ID` AS `affected_customer_id`, `Downgraded` AS `downgraded`, MEASURE(`Revenue`) AS metric_revenue, MEASURE(`Lost Revenue`) AS metric_lost_revenue, MEASURE(`Orders`) AS metric_orders, MEASURE(`Failed Orders`) AS metric_failed_orders, MEASURE(`Payment Attempts`) AS metric_attempts, MEASURE(`Failed Attempts`) AS metric_failed_attempts\nFROM payments_metrics\nWHERE `Affected Customer ID` IS NOT NULL\nGROUP BY ALL ORDER BY metric_lost_revenue DESC"
      ],
      "columns": [
        {
          "displayName": "Revenue",
          "expression": "SUM(`metric_revenue`)"
        },
        {
          "displayName": "Lost Revenue",
          "expression": "SUM(`metric_lost_revenue`)"
        },
        {
          "displayName": "Orders",
          "expression": "SUM(`metric_orders`)"
        },
        {
          "displayName": "Failed Orders",
          "expression": "SUM(`metric_failed_orders`)"
        },
        {
          "displayName": "Payment Attempts",
          "expression": "SUM(`metric_attempts`)"
        },
        {
          "displayName": "Failed Attempts",
          "expression": "SUM(`metric_failed_attempts`)"
        },
        {
          "displayName": "Payment Failure Rate",
          "expression": "SUM(`metric_failed_attempts`) / NULLIF(SUM(`metric_attempts`),0)"
        },
        {
          "displayName": "Affected Enterprise Customers",
          "expression": "COUNT(DISTINCT `affected_customer_id`)"
        }
      ]
    }
  ],
